# Copy to .env.local and fill in.

# Public site address (used for SEO: sitemap, canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin login. Generate the hash with:  npm run hash-password -- "YourStrongPassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string (at least 32 characters) used to sign the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
